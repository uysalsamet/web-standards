# Line endings and binary marks ([CI-26]).

# Normalise to LF in the repository, whatever the developer's platform checks out with.
# Without this, a CRLF-committed shell script fails inside the Linux image with
# "\r: command not found", and every diff shows the whole file as changed.
* text=auto eol=lf

# Files that MUST stay LF even on Windows checkouts: they run inside the container.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
.env.example    text eol=lf

# Windows-only helper scripts stay CRLF or cmd.exe misparses them.
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binaries: never merged, never diffed as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.avif          binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.pdf           binary
*.mp4           binary
*.webm          binary
*.mbtiles       binary
*.pmtiles       binary

# Generated: keep it out of diffs and out of the language statistics ([STR-29]).
package-lock.json   linguist-generated=true -diff
*.gen.ts            linguist-generated=true -diff
src/shared/i18n/keys.d.ts linguist-generated=true -diff

# GeoJSON is text and should diff, but it is data, not source.
*.geojson       text eol=lf linguist-generated=true
