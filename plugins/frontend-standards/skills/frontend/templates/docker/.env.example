# =============================================================================
# .env.example — COMMITTED. Every variable the app needs, with a placeholder
# value that is safe to publish (loopback host, empty string, "example.test").
#
# Real values live in deployments/main/.env.local and .env.prod, which are
# git-ignored ([OPS-29]). Never copy a hostname, an IP of a real server, a
# token or a password into this file.
#
# It has two jobs beyond documentation:
#   1. `tools/nginx-smoke.sh` renders the nginx template with it in CI, so a
#      missing variable fails the pipeline instead of the deploy.
#   2. `diff <(cut -d= -f1 .env.example) <(cut -d= -f1 .env.prod)` is the
#      review step when a variable is added.
#
# Naming ([OPS-32]):
#   APP_*      -> runtime config rendered into /config.js, read by the browser.
#                 PUBLIC by definition. Never a secret ([GEN-10]).
#   NGINX_*    -> substituted into the nginx templates by envsubst.
#   *_UPSTREAM -> a host:port inside the Docker network. Never a URL, never a
#                 scheme, never a trailing slash.
#   DEV_*      -> Vite dev-server proxy targets. Full URLs, host side only.
# =============================================================================

# --- compose ---------------------------------------------------------------
# Prefixes every container, network and volume name. Two apps on one host
# collide on `web` and `nginx-cache` without it.
COMPOSE_PROJECT_NAME=example-app

# Host port the edge publishes. The container always listens on 8080.
NGINX_PORT=8080

# Short git sha, passed on the command line at deploy time ([OPS-04], [OPS-33]):
#   BUILD_ID=$(git rev-parse --short HEAD) docker compose ... up -d --build
BUILD_ID=dev

# --- runtime config -> /config.js (public) ---------------------------------
# Same-origin paths, not absolute URLs ([GEN-22]): the browser talks only to
# its own origin and nginx proxies onward.
APP_API_BASE_URL=/api
APP_TILE_BASE_URL=/tiles
APP_MAP_STYLE_URL=/map/styles/basic/style.json
APP_MQTT_WS_URL=/mqtt
# local | staging | production
APP_ENVIRONMENT=local
# Full git sha. Set from the same value as BUILD_ID at deploy time ([OBS-05]).
APP_RELEASE=0000000000000000000000000000000000000000
# Public origin, used for canonical URLs and sitemap generation.
APP_SITE_URL=https://app.example.test
# A JSON object, single line, no trailing comma. Rendered verbatim into
# /config.js, so it must parse as JSON or the app fails at boot ([STR-20]).
APP_FEATURES_JSON={"heatmap":false,"exportPdf":true}

# --- nginx template --------------------------------------------------------
# Host name used in the CSP connect-src for the WebSocket origin ([SEC-06]).
NGINX_PUBLIC_HOST=app.example.test
# allow | deny. Anything other than production serves robots.deny.txt ([SEO-xx]).
NGINX_ROBOTS_POLICY=deny

# host:port only. NO scheme, NO path, NO trailing slash. In compose these are
# service names; on a host outside the compose project they are IP:port.
# There is deliberately no `:-default` fallback anywhere ([OPS-09]): a missing
# upstream must stop the container, not silently proxy to localhost.
NGINX_UPSTREAM_API=127.0.0.1:7000
NGINX_UPSTREAM_TILES=127.0.0.1:3040
NGINX_UPSTREAM_MAP=127.0.0.1:7211
NGINX_UPSTREAM_MQTT=127.0.0.1:8083
NGINX_UPSTREAM_MEDIA=127.0.0.1:8889
# Dev only: the Vite dev server, used by nginx/dev.conf.template ([NGX-47]).
NGINX_UPSTREAM_VITE=vite:5173

# --- Vite dev server (npm run dev, no Docker) ------------------------------
# Full URLs including scheme. Read by vite.config.ts via loadEnv ([OPS-36]).
DEV_API_TARGET=http://localhost:7000
DEV_TILE_TARGET=http://localhost:3040
DEV_MAP_TARGET=http://localhost:7211
DEV_MQTT_TARGET=http://localhost:8083
DEV_MEDIA_TARGET=http://localhost:8889
